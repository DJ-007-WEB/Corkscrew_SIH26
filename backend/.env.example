# AI provider: OpenRouter
# Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Alternative AI provider: Google Gemini
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Fallback AI provider: NVIDIA NIM
# Get a key from https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=z-ai/glm-5.3-flash

# Optional Database & Auth Configuration
# MONGODB_URI=mongodb://localhost:27017/corkscrew
# GOOGLE_CLIENT_ID=your_google_client_id_here
# JWT_SECRET=your_jwt_secret_key_here
